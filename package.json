{
	"name": "closetkeeper",
	"version": "0.0.0",
	"private": true,
	"description": "Inventory and administration software for a nonprofit clothing closet in Klamath County, Oregon",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=26.8.1"
	},
	"scripts": {
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"module:build": "pnpm --filter @closetkeeper/module build",
		"module:publish:dev": "pnpm --filter @closetkeeper/module publish:dev",
		"bindings": "spacetime generate --lang typescript --module-path spacetimedb --out-dir packages/bindings/src --yes",
		"admin:dev": "pnpm --filter @closetkeeper/admin dev",
		"admin:build": "pnpm --filter @closetkeeper/admin build",
		"module:local": "spacetime start --in-memory --listen-addr 127.0.0.1:3000",
		"module:publish:local": "spacetime publish closetkeeper-local --server local --module-path spacetimedb --delete-data=on-conflict --yes",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.4.1",
		"vitest": "^5.0.0"
	}
}

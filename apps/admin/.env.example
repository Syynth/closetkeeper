# Copy to .env.local for local development. Vite exposes only VITE_* keys to
# the browser, so nothing secret belongs in this file — every value here is
# public by construction (any client connecting to the database learns them).

# Which database the admin app talks to. Local in-memory instance:
VITE_SPACETIMEDB_HOST=ws://localhost:3000
VITE_SPACETIMEDB_DB_NAME=closetkeeper-local
# ...or the disposable Maincloud dev database:
# VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
# VITE_SPACETIMEDB_DB_NAME=closetkeeper-dev

# SpacetimeAuth. One project and one client serve every environment; the
# client's allowed redirect URIs must include this app's origin + /callback.
# The dev server runs on http://localhost:7070 (see vite.config.ts).
VITE_SPACETIMEAUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
VITE_SPACETIMEAUTH_CLIENT_ID=client_034JkHw9y08pQVcNeFcW3u
